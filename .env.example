DATABASE_URL=sqlite:///./pos.db
JWT_SECRET_KEY=change-me-in-production-use-env-32chars

# Kitchen printing (file = dev/test without physical printer)
PRINTER_BACKEND=file
# PRINTER_BACKEND=escpos_network

# Optional: used by image render mode for Myanmar ticket rendering
# KITCHEN_PRINT_FONT_PATH=assets/fonts/NotoSansMyanmar-Regular.ttf

# Route endpoints (LAN IP + port 9100 for Xprinter ESC/POS)
PRINTER_DRINKS_HOST=192.168.1.101
PRINTER_DRINKS_PORT=9100
PRINTER_FOOD_HOST=192.168.1.102
PRINTER_FOOD_PORT=9100

# Optional: directory for file-backend ticket output (defaults to project root)
# KITCHEN_PRINT_OUTPUT_DIR=.
