DATABASE_URL=sqlite:///./pos.db
JWT_SECRET_KEY=change-me-in-production-use-env-32chars

# First container boot only (docker compose). Ignored once /data/db/pos.db exists.
# docker-compose.yml overrides DATABASE_URL and KITCHEN_PRINT_OUTPUT_DIR inside the container.
ROOT_USERNAME=root
ROOT_PASSWORD=change-me-min-6-chars

# Shown on cashier thermal receipts
SHOP_NAME=My Restaurant

# Kitchen / cashier printing seed defaults (admin UI / DB is preferred after first startup)
PRINTER_BACKEND=file
# PRINTER_BACKEND=escpos_network
# PRINTER_BACKEND=windows_printer
# Windows USB receipts: run natively on Windows and pip install -r requirements-windows.txt
PRINTER_RENDER_MODE=text
# PRINTER_RENDER_MODE=image
PRINTER_PAPER_WIDTH_PX=576

# Optional override: image mode prefers assets/fonts/Pyidaungsu.ttf, then NotoSansMyanmar
# KITCHEN_PRINT_FONT_PATH=assets/fonts/Pyidaungsu.ttf

# Route endpoint fallback (LAN IP + port 9100 for Xprinter ESC/POS)
# Admin UI values are used first; these are fallback values when DB host is empty.
PRINTER_DRINKS_HOST=192.168.1.101
PRINTER_DRINKS_PORT=9100
PRINTER_FOOD_HOST=192.168.1.102
PRINTER_FOOD_PORT=9100
PRINTER_CASHIER_HOST=192.168.1.103
PRINTER_CASHIER_PORT=9100

# Optional: directory for file-backend ticket/receipt output (defaults to project root)
# KITCHEN_PRINT_OUTPUT_DIR=.
